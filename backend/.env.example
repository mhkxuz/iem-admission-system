# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Development and production connect to a persistent MongoDB instance.
# Automated tests (NODE_ENV=test) use mongodb-memory-server instead.
MONGODB_URI=mongodb://127.0.0.1:27017/iem_admission_db

# Authentication / JWT
# Replace this placeholder with a long, random value in your local .env file.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# File Uploads (Multer)
UPLOAD_DIR=./uploads/documents
MAX_FILE_SIZE_BYTES=5242880

# Client Application URL for CORS
CORS_ORIGIN=http://localhost:4200

# Payment Gateway Configuration (Stage 4)
# Supported gateways: sandbox | razorpay
PAYMENT_GATEWAY=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email / SMTP Notification Configuration (Stage 4)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=admissions@iem.edu

# Administrator Seed Script
# Used only by scripts/seed-admin.js. Set strong, private values in .env.
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_NAME=IEM Admissions Administrator
ADMIN_PHONE=9876543200

# Reviewer Seed Script (Stage 2)
# Used only by scripts/seed-reviewer.js. Set strong, private values in .env.
REVIEWER_EMAIL=reviewer@example.edu
REVIEWER_PASSWORD=replace_with_a_strong_password
REVIEWER_NAME=IEM Document Reviewer
REVIEWER_PHONE=9876543201
