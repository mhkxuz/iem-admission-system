{
  "name": "mean-admission-system",
  "version": "1.0.0",
  "description": "IEM Online Admission System — MEAN Stack POC",
  "private": true,
  "scripts": {
    "db:start": "cd backend && npm run db:start",
    "start:backend": "cd backend && npm start",
    "dev:backend": "cd backend && npm run dev",
    "start:frontend": "cd frontend && npm start",
    "build:frontend": "cd frontend && npm run build",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test -- --no-watch",
    "test": "npm run test:backend && npm run test:frontend",
    "seed:admin": "cd backend && node scripts/seed-admin.js",
    "seed:reviewer": "cd backend && node scripts/seed-reviewer.js",
    "seed:programmes": "cd backend && node scripts/seed-programmes.js"
  },
  "keywords": [
    "mean-stack",
    "angular",
    "nodejs",
    "express",
    "mongodb",
    "mongoose"
  ],
  "author": "IEM Software Engineering Lab",
  "license": "ISC",
  "devDependencies": {}
}
